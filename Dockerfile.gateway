FROM node:22-alpine AS dashboard
WORKDIR /build/dashboard
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build
FROM maven:3.9-eclipse-temurin-17 AS java
WORKDIR /build
COPY control-plane/ ./
COPY --from=dashboard /build/control-plane/src/main/resources/static/ ./src/main/resources/static/
RUN mvn -B package
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=java /build/target/control-plane-1.0.0.jar app.jar
CMD ["java","-jar","app.jar","--server.address=0.0.0.0"]
